{
  "expo": {
    "name": "Apex",
    "slug": "apex",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0C10",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.apexis.run",
      "infoPlist": {
        "UIBackgroundModes": [
          "location"
        ],
        "NSMotionUsageDescription": "Apex uses motion data to count your steps and measure cadence during runs."
      }
    },
    "android": {
      "package": "com.apexis.run",
      "adaptiveIcon": {
        "backgroundColor": "#0A0C10",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "ACTIVITY_RECOGNITION",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.WRITE_EXERCISE",
        "android.permission.health.READ_EXERCISE_ROUTES",
        "android.permission.health.WRITE_EXERCISE_ROUTE",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.WRITE_DISTANCE",
        "android.permission.health.READ_TOTAL_CALORIES_BURNED",
        "android.permission.health.WRITE_TOTAL_CALORIES_BURNED",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_HEALTH_DATA_HISTORY"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withPodDeploymentTarget",
      "./plugins/withSceneLifecycle",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#0A0C10",
          "imageWidth": 220
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          },
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Apex uses your location to record your running route, distance and pace.",
          "locationAlwaysAndWhenInUsePermission": "Allow background access so Apex keeps tracking your run when the screen is off or you switch apps.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Apex uses motion data to count steps and measure cadence during runs."
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Apex reads your workouts and body weight from Apple Health to import past runs and personalize calorie estimates.",
          "NSHealthUpdateUsageDescription": "Apex saves your runs to Apple Health so they appear in the Health and Fitness apps.",
          "background": false
        }
      ],
      "react-native-health-connect"
    ]
  }
}
